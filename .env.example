# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN commit file .env ke git!

PORT=8051

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=ganti_dengan_password_kuat
DB_NAME=seleksimitra

# Session - gunakan string acak minimal 32 karakter
# Generate: openssl rand -base64 32
SESSION_KEY=ganti_dengan_random_string_minimal_32_karakter

# Object Storage (MinIO/S3)
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=ganti_access_key
AWS_SECRET_ACCESS_KEY=ganti_dengan_secret_kuat
AWS_BUCKET=sirekap
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=true

# Set ke "true" jika app diakses via HTTPS (production)
SESSION_SECURE=true
